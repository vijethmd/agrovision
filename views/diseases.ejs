<section class="diseases-library">
  <div class="container">
    <div class="section-title">
      <h2>Crop Disease Library</h2>
      <p>
        Comprehensive information about common crop diseases and their
        identification
      </p>
    </div>

    <div class="search-filter">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input
          type="text"
          placeholder="Search diseases..."
          id="diseaseSearch"
        />
      </div>
      <div class="filter-options">
        <select id="cropFilter">
          <option value="">All Crops</option>
          <option value="tomato">Tomato</option>
          <option value="potato">Potato</option>
          <option value="corn">Corn</option>
          <option value="wheat">Wheat</option>
          <option value="rice">Rice</option>
        </select>
        <select id="typeFilter">
          <option value="">All Types</option>
          <option value="fungal">Fungal</option>
          <option value="bacterial">Bacterial</option>
          <option value="viral">Viral</option>
          <option value="pest">Pest-related</option>
        </select>
      </div>
    </div>

    <div class="diseases-grid">
      <% diseases.forEach(disease => { %>
      <div
        class="disease-item"
        data-crop="<%= disease.crop.toLowerCase() %>"
        data-type="<%= disease.type.toLowerCase() %>"
      >
        <div class="disease-image">
          <img src="<%= disease.image %>" alt="<%= disease.name %>" />
          <div
            class="severity-badge severity-<%= disease.severity.toLowerCase() %>"
          >
            <%= disease.severity %> Severity
          </div>
        </div>
        <div class="disease-content">
          <div class="disease-meta">
            <span class="crop-type"
              ><i class="fas fa-leaf"></i> <%= disease.crop %></span
            >
            <span class="disease-type"
              ><i class="fas fa-virus"></i> <%= disease.type %></span
            >
          </div>
          <h3><%= disease.name %></h3>
          <p><%= disease.description %></p>
          <div class="symptoms">
            <h4>Common Symptoms:</h4>
            <ul>
              <% disease.symptoms.forEach(symptom => { %>
              <li><i class="fas fa-check-circle"></i> <%= symptom %></li>
              <% }) %>
            </ul>
          </div>
          <div class="disease-actions">
            <a href="/detect" class="btn btn-small">
              <i class="fas fa-camera"></i> Detect
            </a>
            <a
              href="/solutions/<%= disease.name.toLowerCase().replace(/\s+/g, '-') %>"
              class="btn btn-outline btn-small"
            >
              <i class="fas fa-lightbulb"></i> Solutions
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
